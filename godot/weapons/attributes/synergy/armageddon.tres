[gd_resource type="Resource" script_class="MeteorAttributeClass" format=3]

[ext_resource type="Script" path="res://weapons/attributes/behaviors/meteor_attribute.gd" id="1_attribute"]
[ext_resource type="Script" path="res://weapons/attributes/base/attribute_scaling.gd" id="2_scaling"]
[ext_resource type="Resource" path="res://weapons/attributes/special/meteor.tres" id="3_res"]
[ext_resource type="Resource" path="res://weapons/attributes/special/starfall.tres" id="4_res"]
[ext_resource type="PackedScene" path="res://weapons/projectiles/meteor.tscn" id="5_res"]
[ext_resource type="Resource" path="res://damage/fire.tres" id="6_res"]

[sub_resource type="Resource" id="Resource_scaling"]
script = ExtResource("2_scaling")
minBase = 0.2
maxBase = 0.25
perStep = 0.004
percent = true

[sub_resource type="Resource" id="Resource_chance"]
script = ExtResource("2_scaling")
minBase = 0.3
maxBase = 0.4
perStep = 0.005
percent = true

[sub_resource type="Resource" id="Resource_count"]
script = ExtResource("2_scaling")
minBase = 3.0
maxBase = 3.0
wholeNumber = true

[resource]
script = ExtResource("1_attribute")
meteorScene = ExtResource("5_res")
radius = 20.0
damageType = ExtResource("6_res")
countScaling = SubResource("Resource_count")
scatter = 40.0
attributeName = "Armageddon"
description = "Armageddon: {chance}% Meteor brings {count} more, {value}%"
scaling = SubResource("Resource_scaling")
trigger = 5
chanceScaling = SubResource("Resource_chance")
requiredAttributes = Array[Resource]([ExtResource("3_res"), ExtResource("4_res")])
procSource = ExtResource("3_res")
