[gd_resource type="Resource" script_class="StatusAttributeClass" format=3]

[ext_resource type="Script" path="res://weapons/attributes/behaviors/status_attribute.gd" id="1_attribute"]
[ext_resource type="Script" path="res://weapons/attributes/base/attribute_scaling.gd" id="2_scaling"]
[ext_resource type="Resource" path="res://weapons/effects/frost/frost.tres" id="3_element"]

[sub_resource type="Resource" id="Resource_scaling"]
script = ExtResource("2_scaling")
minBase = 0.15
maxBase = 0.2
perStep = 0.004
percent = true

[sub_resource type="Resource" id="Resource_chance"]
script = ExtResource("2_scaling")
minBase = 0.12
maxBase = 0.16
perStep = 0.002
percent = true

[resource]
script = ExtResource("1_attribute")
element = ExtResource("3_element")
attributeName = "Chill"
description = "{chance}% Chill: {value}% frostbite dmg"
scaling = SubResource("Resource_scaling")
