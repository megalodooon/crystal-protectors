[gd_resource type="Resource" script_class="DebuffAttributeClass" format=3]

[ext_resource type="Script" path="res://weapons/attributes/behaviors/debuff_attribute.gd" id="1_attribute"]
[ext_resource type="Script" path="res://weapons/attributes/base/attribute_scaling.gd" id="2_scaling"]
[ext_resource type="Resource" path="res://status_effects/debuffs/slow.tres" id="3_status"]

[sub_resource type="Resource" id="Resource_scaling"]
script = ExtResource("2_scaling")
minBase = 0.2
maxBase = 0.25
perStep = 0.003
percent = true

[sub_resource type="Resource" id="Resource_chance"]
script = ExtResource("2_scaling")
minBase = 0.3
maxBase = 0.4
perStep = 0.007
percent = true

[resource]
script = ExtResource("1_attribute")
status = ExtResource("3_status")
attributeName = "Hamstring"
description = "{chance}% on crit: {value}% Slow"
scaling = SubResource("Resource_scaling")
trigger = 3
chanceScaling = SubResource("Resource_chance")
