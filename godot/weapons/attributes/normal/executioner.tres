[gd_resource type="Resource" script_class="HealthDamageAttributeClass" format=3]

[ext_resource type="Script" path="res://weapons/attributes/behaviors/health_damage_attribute.gd" id="1_attribute"]
[ext_resource type="Script" path="res://weapons/attributes/base/attribute_scaling.gd" id="2_scaling"]

[sub_resource type="Resource" id="Resource_scaling"]
script = ExtResource("2_scaling")
